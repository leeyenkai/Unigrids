<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Mac app's entitlements, which need no development team.

  The Mac build runs with the hardened runtime, which refuses location and the Photos
  library to an app that does not declare them — without these the Mac's "Where am I",
  stamp verification and photo import failed silently. The app is not sandboxed while
  it is unsigned; `Unigrids-iCloud.entitlements` holds what sync will add.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<key>com.apple.security.personal-information.photos-library</key>
	<true/>
</dict>
</plist>
